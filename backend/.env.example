# Database (Supabase direct connection)
# Format: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Telegram — бот платформы (@yoursaas_bot)
PLATFORM_BOT_TOKEN=7xxx:AAFyyy

# Секрет для /internal/ эндпоинтов (бот → API)
# Генерация: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_SECRET=generate-random-64-char-string

# Ключ шифрования токенов ботов мастеров
# Генерация: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BOT_ENCRYPTION_KEY=your-fernet-key-here

# JWT
# Генерация: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Cloudflare R2 (нужно в Фазе 2 — загрузка фото)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=beauty-photos
R2_PUBLIC_URL=

# URL приложения
APP_BASE_URL=https://your-frontend-url.com
API_BASE_URL=https://your-api-url.com
